# ─────────────────────────────────────────────────────────────────────────────
# CBA-MCP — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
#
# Credential ownership:
#   USER-PROVIDED    → each user sets this themselves
#   OPERATOR-LOADED  → pre-configured by the server admin in mcp.json env block
# ─────────────────────────────────────────────────────────────────────────────

# ── Transport ──────────────────────────────────────────────────────────────────
# "stdio"  → for Cursor, Claude Desktop (default)
# "http"   → for remote agents, n8n, LangChain, etc.
TRANSPORT=stdio
PORT=3000

# ── Admin Panel API Key  [USER-PROVIDED] ───────────────────────────────────────
# The only credential end users need to supply.
# All read tools require this key to authenticate against the Admin Panel API.
ADMIN_PANEL_API_KEY=

# ── Admin Panel Domain  [OPERATOR-LOADED] ─────────────────────────────────────
# Set once by the server operator. Users do not need to touch this.
ADMIN_PANEL_DOMAIN=https://your-admin-panel.trainerize.com

# ── Bitrise  [OPERATOR-LOADED] ────────────────────────────────────────────────
# Pre-loaded by the operator. Required for trigger_app_build / get_build_status.
BITRISE_TOKEN=

# ── Jenkins  [OPERATOR-LOADED] ────────────────────────────────────────────────
# Pre-loaded by the operator. Required for Jenkins-based build tools.
JENKINS_URL=https://your-jenkins.example.com
JENKINS_USER=your-username
JENKINS_API_KEY=

# ── AWS / S3  [OPERATOR-LOADED] ───────────────────────────────────────────────
# Pre-loaded by the operator. Required for the CSV data layer (Phase 2).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_KEY=path/to/cba_apps_dump.csv
