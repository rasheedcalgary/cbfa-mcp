# ─────────────────────────────────────────────────────────────────────────────
# CBA-MCP — Server Infrastructure Environment Variables
#
# This file is for OPERATOR use only. It configures the server's own infra.
# Copy to .env and fill in before starting the server.
# NEVER commit .env to git.
#
# ADMIN_PANEL_API_KEY is NOT here — it is user-supplied via each user's
# mcp.json env block. See README for the mcp.json snippet to share with users.
# ─────────────────────────────────────────────────────────────────────────────

# ── Transport ──────────────────────────────────────────────────────────────────
# "stdio"  → for Cursor, Claude Desktop (default)
# "http"   → for remote agents (n8n, LangChain, OpenAI Agents SDK, etc.)
TRANSPORT=stdio
PORT=3000

# ── Admin Panel (server infra) ─────────────────────────────────────────────────
# Base URL of the Trainerize Admin Panel API.
# ADMIN_PANEL_API_KEY is NOT set here — users supply it themselves via mcp.json.
ADMIN_PANEL_DOMAIN=https://your-admin-panel.trainerize.com

# ── Bitrise ────────────────────────────────────────────────────────────────────
# Required for trigger_app_build, get_build_status, analyze_build_log (iOS).
# BITRISE_TOKEN: Bitrise → Profile → Security → Personal Access Tokens
# BITRISE_APP_SLUG: Bitrise → App → Code → App Slug (or from the app URL)
#   iOS workflows:
#     New app creation  → New_App_Creation_Flow
#     Batch / updates   → DEPLOY_testflight_S3_2026
BITRISE_TOKEN=
BITRISE_APP_SLUG=de36db0d3356751f

# ── Jenkins ────────────────────────────────────────────────────────────────────
# Required for trigger_app_build and get_build_status (provider=jenkins).
# JENKINS_API_KEY: Jenkins → <username> → Configure → API Token
JENKINS_URL=https://your-jenkins.example.com
JENKINS_USER=your-username
JENKINS_API_KEY=

# ── AWS / S3 (Data Layer — Phase 2) ───────────────────────────────────────────
# Read-only IAM credentials for the S3 bucket that holds the CBA CSV dump.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_KEY=path/to/cba_apps_dump.csv

# ── CircleCI ───────────────────────────────────────────────────────────────────
# Required for analyze_circleci_build — debugs Glofox CBA build failures.
# Targets: glofoxinc organisation / standalone-app-builder pipeline.
# CIRCLE_CI_TOKEN: CircleCI → User Settings → Personal API Tokens
CIRCLE_CI_TOKEN=