# ─────────────────────────────────────────────────
# CBA-MCP — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────

# ── Transport ─────────────────────────────────────
# "stdio"  → used by Cursor, Claude Desktop (default)
# "http"   → used by remote agents, n8n, LangChain, etc.
TRANSPORT=stdio
PORT=3000

# ── Admin Panel API (Read Tools) ──────────────────
# Required for: list_apps, get_app_info, get_ios_status,
#               get_android_status, get_app_last_updated,
#               get_pending_apps, get_stale_apps
ADMIN_PANEL_API_KEY=
ADMIN_PANEL_DOMAIN=https://your-admin-panel.trainerize.com

# ── Bitrise (Action Tools) ────────────────────────
# Required for: trigger_app_build (provider=bitrise), get_build_status (provider=bitrise)
# Get from: Bitrise → Profile → Security → Personal Access Tokens
BITRISE_TOKEN=

# ── Jenkins (Action Tools) ────────────────────────
# Required for: trigger_app_build (provider=jenkins), get_build_status (provider=jenkins)
JENKINS_URL=https://your-jenkins.example.com
JENKINS_USER=your-username
JENKINS_API_KEY=

# ── AWS / S3 (Data Layer — Phase 2) ───────────────
# Required for the CSV dump data source.
# Read-only IAM credentials to the existing cbfa-scripts S3 bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_KEY=path/to/cba_apps_dump.csv
