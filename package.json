{
  "name": "cba-mcp",
  "version": "0.1.0",
  "description": "Custom Branded Apps MCP Server — connects to Cursor, Claude Desktop, and any MCP-compatible agent",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cba-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx watch src/index.ts",
    "dev:http": "TRANSPORT=http tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "TRANSPORT=http node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "axios": "^1.7.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
